+def stable_service_id(address, store_dir=None):
+    """A 12-hex AirDrop instance ID that survives restarts.
+
+    The upstream implementation used a fresh secrets.token_hex(6) on every
+    start, so iPhone treated each launch as a new receiver and had to
+    rediscover it. Deriving it from the AWDL IPv6 IID is still not stable:
+    awdld picks a new random AWDL MAC every start, so the address (and the ID)
+    changes (observed: 8e2c9afffe41, b011eefffed7, ...) and the iPhone lists
+    every past ID as another "AirBridge32". Persist the first value under the
+    keys directory and reuse it.
+    """
+    saved = None
+    path = os.path.join(store_dir, 'airdrop-service-id') if store_dir else None
+    if path:
+        try:
+            with open(path, encoding='ascii') as handle:
+                candidate = handle.read().strip().lower()
+            if re.fullmatch('[0-9a-f]{12}', candidate):
+                saved = candidate
+        except OSError:
+            saved = None
+    if saved:
+        return saved
+    try:
+        packed = ipaddress.IPv6Address(str(address).split('%')[0]).packed
+        value = packed[8:14].hex()
+    except (ipaddress.AddressValueError, ValueError):
+        value = secrets.token_hex(6)
+    if path:
+        try:
+            os.makedirs(store_dir, exist_ok=True)
+            with open(path, 'w', encoding='ascii') as handle:
+                handle.write(value + '\n')
+        except OSError:
+            pass
+    return value
